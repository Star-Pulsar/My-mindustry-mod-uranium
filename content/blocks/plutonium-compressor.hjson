itemCapacity: 20

hasPower: true
consumes: {
  power: 3.5
  items: [
    uranium/3
    lead/5
  ]
}

outputItem: plutonium/1

# Исправлено: теперь во время работы выделяется стандартный дым
updateEffect: smoke
craftEffect: pulverize

requirements: [
  copper/150
  lead/120
  silicon/50
]

